# Gradle
.gradle/
build/

# Kotlin (cache compilatore)
.kotlin/

# Android Studio / IntelliJ
.idea/
*.iml
captures/

# Configurazione locale (percorso SDK, ecc.)
local.properties

# Chiavi di firma
*.jks
*.keystore

# Log e varie
*.log
.DS_Store

# Contenuti Project Aon, solo uso personale locale — non vanno nel repo né nell'APK
content/scenes.json
# I libri in doc/LIBRI/ SONO versionati, ma senza prosa: contengono le
# sole meccaniche (README §15). I file riempiti con i testi originali
# escono in tool/build/libri/ — già coperto da `build/` sopra, elencato
# qui perché si veda a colpo d'occhio che è voluto e non una svista.
tool/build/libri/
# La copia locale scaricata da projectaon.org
tool/build/projectaon/

# Backup di rotazione dell'editor (§10 EDITOR.md, BookStorage.kt):
# copie automatiche a ogni salvataggio, non contenuto da versionare —
# la cronologia la fa git sul file vero, non queste copie ridondanti.
*.bak[0-9]

# Libri convertiti da Project Aon per prove personali (29/07/2026, Michele:
# "uso mio personale e di mio figlio... non deve contenere libri"):
# sorgenti HTML e JSON convertiti, mai nell'APK. 30/07/2026, Michele:
# "salva su git tutte le risorse anche i libri sotto doc che ci
# servono per fare i test... è utile fare il revert con git se si
# rompono" — versionati anche loro, per lo stesso motivo per cui è
# versionato content/test-books/.
# Rapporti di crash della JVM (02/08/2026): li scrive la JVM stessa
# nella cartella di lavoro quando muore in codice nativo. Utili da
# leggere, mai da versionare.
hs_err_pid*.log
replay_pid*.log
